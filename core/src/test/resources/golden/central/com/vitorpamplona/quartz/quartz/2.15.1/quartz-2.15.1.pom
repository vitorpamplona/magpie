<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.vitorpamplona.quartz</groupId>
  <artifactId>quartz</artifactId>
  <version>2.15.1</version>
  <name>Quartz: Nostr Library for Kotlin Multiplatform</name>
  <description>Nostr protocol library for Kotlin Multiplatform: JVM, Android, iOS, macOS and Linux</description>
  <url>https://github.com/vitorpamplona/quartz/</url>
  <inceptionYear>2025</inceptionYear>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/vitorpamplona/quartz/blob/main/LICENSE</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>vitorpamplona</id>
      <name>Vitor Pamplona</name>
      <email>vitor@vitorpamplona.com</email>
      <url>https://vitorpamplona.com</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/vitorpamplona/quartz.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/vitorpamplona/quartz.git</developerConnection>
    <url>https://github.com/vitorpamplona/quartz/</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/vitorpamplona/quartz/issues</url>
  </issueManagement>
  <dependencies>
    <dependency>
      <groupId>fr.acinq.secp256k1</groupId>
      <artifactId>secp256k1-kmp</artifactId>
      <version>0.24.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>androidx.sqlite</groupId>
      <artifactId>sqlite</artifactId>
      <version>2.7.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.vitorpamplona.negentropy</groupId>
      <artifactId>kmp-negentropy</artifactId>
      <version>v1.2.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.vitorpamplona.crypto</groupId>
      <artifactId>crypto</artifactId>
      <version>2.1.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.4.21</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-core</artifactId>
      <version>1.11.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>androidx.collection</groupId>
      <artifactId>collection</artifactId>
      <version>1.7.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>androidx.compose.runtime</groupId>
      <artifactId>runtime-annotation</artifactId>
      <version>1.12.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-serialization-json</artifactId>
      <version>1.12.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-serialization-cbor</artifactId>
      <version>1.12.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-collections-immutable</artifactId>
      <version>0.5.2</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>androidx.sqlite</groupId>
      <artifactId>sqlite-bundled</artifactId>
      <version>2.7.1</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
